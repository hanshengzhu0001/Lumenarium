# Copy this file to .env.lumenarium and replace every required value.
# Never commit .env.lumenarium.

# Gemini-compatible visual language endpoint used by S1.
GPT_API_KEY=replace-with-your-api-key
GPT_ENDPOINT=https://your-gemini-compatible-endpoint/v1/gemini/stream
GPT_MODEL=gemini-3.1-pro-preview

# DeepSearch endpoint used by S2. It must expose the Lumenarium /search contract.
OMNIVERSE_DEEPSEARCH_URL=https://your-deepsearch-endpoint/search
# Only needed when the endpoint itself requires a JWT.
OMNIVERSE_JWT_TOKEN=

# Optional Grounding-DINO API token. SAM3 is the default production detector.
GROUND_DINO_TOKEN=

# API server/worker authentication. ASCII only; generate a long random value.
SCENEPROOF_WORKER_TOKEN=replace-with-a-long-random-ascii-token

# Production-safe concurrency. See README before increasing these values.
SCENEPROOF_API_DEEPSEARCH_WORKERS=4
# Leave empty to auto-select GPU 0 or GPUs 0,1; set an explicit comma list if needed.
SCENEPROOF_API_GPU_IDS=
IMAGINARIUM_PARALLEL_GPT_PROCESSES=1
IMAGINARIUM_GPT_LOCK_FILE=/tmp/lumenarium_api_gemini.lock

# Optional Hugging Face token for gated SAM3/model downloads.
HF_TOKEN=
